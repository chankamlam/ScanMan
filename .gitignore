# ============================================================
# 代码漏洞检测 / 分类项目 —— 忽略清单
# ============================================================
# 原则：代码、配置、文档、小体积的示例产物要提交；
#       数据、模型权重、训练产物体积太大（合计 6.8 GB），一律不提交，
#       需要时用 scripts/ 下的下载脚本重新拉取。

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------- 测试与质量工具的缓存 ----------
# 都是工具自己生成的中间文件，删掉随时能重新跑出来
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------- Jupyter ----------
# 误在仓库里开 notebook 时产生的检查点副本
.ipynb_checkpoints/

# ---------- IDE ----------
# PyCharm / VSCode 的配置里写的是本机绝对路径，换机器就没用了
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ---------- 本地私有配置 / 密钥 ----------
# API key、HF token 之类只放在本机，绝不进版本库
.env
.env.*
# Claude Code 的本机授权记录，含本机绝对路径
.claude/settings.local.json

# ---------- 云同步工具 ----------
# Dropbox 会在被同步的目录里建 .sync/ 存元数据，不属于项目内容
.sync/
*.dropbox

# ---------- 数据集（约 4 GB）----------
# 用 scripts/download_data.py 重新下载，
# 或用 scripts/build_dataset.py 从 data/raw 重新构建
data/raw/
data/processed/

# ---------- 预训练模型权重（约 477 MB）----------
# 用 scripts/download_model.py 重新下载
models/

# ---------- 训练产物 ----------
# 只忽略大文件；config.yaml / results.json / report_*.txt / *.npy / label_map.json
# 这些小文件要留档，方便复现实验和事后分析（见 docs/05_训练产物说明.md）。
# outputs/ 根目录下的扫描报告（scan_result.json 等）也只有几十 KB，可以提交。
outputs/*/best/*.bin
outputs/*/best/*.safetensors
outputs/*/*.npy
# 中间检查点（改回 HF Trainer 的 save_strategy 时会出现），每个约 500 MB
outputs/*/checkpoint-*/

# ---------- 模型权重与训练状态（兜底）----------
# 上面按目录忽略，这里按扩展名兜底，防止换了输出路径就漏进仓库
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# ---------- 日志 ----------
*.log
logs/
# 训练监控（本项目当前没接，接了之后别把 run 目录提交上去）
wandb/
lightning_logs/
mlruns/

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
