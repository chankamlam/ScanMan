# ============================================================
# 代码漏洞检测 / 分类项目 —— 忽略清单
# ============================================================
# 原则：代码、配置、文档、小体积的示例产物要提交；
#       数据、模型权重、训练产物体积太大（合计 6.8 GB），一律不提交，
#       需要时用 scripts/ 下的下载脚本重新拉取。

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------- Node / 前端（web/ 目录）----------
# web/ 有自己的 .gitignore，这里再兜一道：node_modules 一旦漏进去
# 就是几万个文件，事后清理很麻烦。
node_modules/
web/dist/
.vite/

# ---------- 测试与质量工具的缓存 ----------
# 都是工具自己生成的中间文件，删掉随时能重新跑出来
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------- Jupyter ----------
# 误在仓库里开 notebook 时产生的检查点副本
.ipynb_checkpoints/

# ---------- IDE ----------
# PyCharm / VSCode 的配置里写的是本机绝对路径，换机器就没用了
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ---------- 本地私有配置 / 密钥 ----------
# API key、HF token 之类只放在本机，绝不进版本库
.env
.env.*
# Claude Code 的本机授权记录，含本机绝对路径
.claude/settings.local.json

# ---------- 云同步工具 ----------
# Dropbox 会在被同步的目录里建 .sync/ 存元数据，不属于项目内容
.sync/
*.dropbox

# ---------- 数据集（约 4 GB）----------
# 用 scripts/download_data.py 重新下载，
# 或用 scripts/build_dataset.py 从 data/raw 重新构建
data/raw/
data/processed/

# ---------- 预训练模型权重（约 477 MB）----------
# 用 scripts/download_model.py 重新下载
models/

# ---------- 训练产物 ----------
# 原则：**留档的提交，跑模型用的不提交**。
#   config.yaml / results.json / report_*.txt / label_map.json / *_stats.json
#   记录了这个实验的全部信息（超参、指标、每类表现），只有几十 KB，必须留档
#   （见 docs/05_训练产物说明.md）。
#   pytorch_model.bin（约 500 MB）和 tokenizer.json（约 3.5 MB）只在**跑推理**
#   时才需要 —— 而权重既然不提交，clone 下来的人也永远跑不了这个检查点，
#   单独留一份分词器没有任何意义，只是白占仓库体积。
outputs/*/best/*.bin
outputs/*/best/*.safetensors
# 分词器是标准 CodeBERT 词表，各 run 之间还有重复；用 download_model.py 重新拉即可
outputs/*/best/tokenizer.json
outputs/*/*.npy
# 中间检查点（改回 HF Trainer 的 save_strategy 时会出现），每个约 500 MB
outputs/*/checkpoint-*/

# 从云端打包带回的产物（.tar.gz 动辄几个 GB）。
# 里面的内容解开后就是正常的 run 目录，归档本身没必要进版本库。
*.tar.gz
*.tar
*.tgz
*.zip

# ---------- 模型权重与训练状态（兜底）----------
# 上面按目录忽略，这里按扩展名兜底，防止换了输出路径就漏进仓库
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# ---------- 日志 ----------
*.log
logs/
# 训练监控（本项目当前没接，接了之后别把 run 目录提交上去）
wandb/
lightning_logs/
mlruns/

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
