# ============================================================
# 代码漏洞检测 / 分类项目 —— 忽略清单
# ============================================================
# 原则：代码、配置、文档、小体积的示例产物要提交；
#       数据、模型权重、训练产物体积太大（合计 6.8 GB），一律不提交，
#       需要时用 scripts/ 下的下载脚本重新拉取。

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------- IDE ----------
# PyCharm / VSCode 的配置里写的是本机绝对路径，换机器就没用了
.idea/
.vscode/
*.iml
*.swp

# ---------- 云同步工具 ----------
# Dropbox 会在被同步的目录里建 .sync/ 存元数据，不属于项目内容
.sync/
*.dropbox
desktop.ini

# ---------- 数据集（约 4 GB）----------
# 用 scripts/download_data.py 重新下载，
# 或用 scripts/build_dataset.py 从 data/raw 重新构建
data/raw/
data/processed/

# ---------- 预训练模型权重（约 477 MB）----------
# 用 scripts/download_model.py 重新下载
models/

# ---------- 训练产物（每个检查点约 475 MB）----------
# 只忽略大文件；results.json 之类的小文件如果要留档可以手动放开
outputs/*/best/pytorch_model.bin
outputs/*/*.npy

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
